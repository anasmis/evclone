{
  "kind": "collectionType",
  "collectionName": "platform_demo_requests",
  "info": {
    "singularName": "platform-demo-request",
    "pluralName": "platform-demo-requests",
    "displayName": "Platform Demo Requests",
    "description": "Demandes de démonstration de la plateforme EVPLUG"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "position": {
      "type": "string",
      "maxLength": 100
    },
    "company": {
      "type": "string",
      "required": true,
      "maxLength": 150
    },
    "sector": {
      "type": "enumeration",
      "enum": [
        "Sélectionner un secteur",
        "Automobile & Transport",
        "Immobilier & Construction",
        "Hôtellerie & Tourisme",
        "Retail & Grande Distribution",
        "Services & Consulting",
        "Industrie & Manufacturing",
        "Secteur Public",
        "Autre"
      ],
      "default": "Sélectionner un secteur"
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true,
      "maxLength": 20
    },
    "stations": {
      "type": "enumeration",
      "enum": [
        "Une à dix bornes (Démarrage)",
        "Onze à cinquante bornes (Développement)",
        "Cinquante à cent bornes (Expansion)",
        "Plus de cent bornes (Grande échelle)",
        "Je ne sais pas encore"
      ],
      "default": "Une à dix bornes (Démarrage)"
    },
    "timeline": {
      "type": "enumeration",
      "enum": [
        "Dès que possible (moins d'un mois)",
        "Dans les trois prochains mois",
        "Dans les six prochains mois",
        "Plus tard (plus de six mois)",
        "Je fais juste de la veille"
      ],
      "default": "Dès que possible (moins d'un mois)"
    },
    "budget": {
      "type": "enumeration",
      "enum": [
        "Préférer ne pas divulguer pour l'instant",
        "Moins de cinquante mille DH",
        "Cinquante mille à deux cent mille DH",
        "Deux cent mille à cinq cent mille DH",
        "Cinq cent mille DH à un million DH",
        "Plus d'un million DH"
      ],
      "default": "Préférer ne pas divulguer pour l'instant"
    },
    "message": {
      "type": "text"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "nouveau",
        "contacté",
        "demo_programmée",
        "demo_réalisée",
        "client_potentiel",
        "fermé"
      ],
      "default": "nouveau"
    },
    "source": {
      "type": "string",
      "default": "Platform Page"
    },
    "notes": {
      "type": "text"
    },
    "assignedTo": {
      "type": "string"
    },
    "followUpDate": {
      "type": "datetime"
    }
  }
}
