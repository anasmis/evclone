{
  "kind": "collectionType",
  "collectionName": "enterprise_requests",
  "info": {
    "singularName": "enterprise-request",
    "pluralName": "enterprise-requests",
    "displayName": "Enterprise Requests",
    "description": "Demandes pour solutions de recharge d'entreprise"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "position": {
      "type": "string",
      "maxLength": 100
    },
    "company": {
      "type": "string",
      "required": true,
      "maxLength": 150
    },
    "industry": {
      "type": "enumeration",
      "enum": [
        "Automobile",
        "Transport & Logistique",
        "Services",
        "Industrie",
        "Commerce",
        "Hôtellerie",
        "Immobilier",
        "Secteur Public",
        "Autre"
      ],
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true,
      "maxLength": 20
    },
    "companySize": {
      "type": "enumeration",
      "enum": [
        "Moins de dix employés",
        "Dix à cinquante employés",
        "Cinquante à deux cents employés",
        "Plus de deux cents employés"
      ],
      "required": true
    },
    "fleetSize": {
      "type": "enumeration",
      "enum": [
        "Pas de flotte",
        "Un à dix véhicules",
        "Dix à cinquante véhicules",
        "Plus de cinquante véhicules"
      ],
      "required": true
    },
    "solutionType": {
      "type": "enumeration",
      "enum": [
        "Bornes pour employés",
        "Bornes pour flotte",
        "Bornes pour clients",
        "Solution complète",
        "Je ne sais pas"
      ],
      "required": true
    },
    "desiredStations": {
      "type": "enumeration",
      "enum": [
        "Une à cinq bornes",
        "Cinq à quinze bornes",
        "Quinze à trente bornes",
        "Plus de trente bornes",
        "Je ne sais pas"
      ],
      "required": true
    },
    "timeline": {
      "type": "enumeration",
      "enum": [
        "Urgente (moins d'un mois)",
        "Court terme (un à trois mois)",
        "Moyen terme (trois à six mois)",
        "Long terme (plus de six mois)"
      ],
      "required": true
    },
    "budget": {
      "type": "enumeration",
      "enum": [
        "Moins de cent mille DH",
        "Cent mille à cinq cent mille DH",
        "Cinq cent mille DH à un million DH",
        "Plus d'un million DH",
        "Non défini"
      ]
    },
    "goals": {
      "type": "json",
      "description": "Array of selected goals",
      "default": []
    },
    "hasExistingInfrastructure": {
      "type": "boolean",
      "default": false
    },
    "message": {
      "type": "text"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "nouveau",
        "qualifié",
        "rendez_vous_programmé",
        "présentation_faite",
        "devis_envoyé",
        "négociation",
        "client_potentiel",
        "fermé"
      ],
      "default": "nouveau"
    },
    "source": {
      "type": "string",
      "default": "EvEntreprise Page"
    },
    "notes": {
      "type": "text"
    },
    "assignedTo": {
      "type": "string"
    },
    "leadScore": {
      "type": "integer",
      "min": 0,
      "max": 100
    }
  }
}
