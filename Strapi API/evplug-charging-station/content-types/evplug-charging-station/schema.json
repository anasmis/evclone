{
  "kind": "collectionType",
  "collectionName": "evplug_charging_stations",
  "info": {
    "singularName": "evplug-charging-station",
    "pluralName": "evplug-charging-stations",
    "displayName": "EVPlug Charging Station"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "latitude": {
      "type": "decimal",
      "required": true
    },
    "longitude": {
      "type": "decimal",
      "required": true
    },
    "city": {
      "type": "string"
    },
    "stationStatus": {
      "type": "enumeration",
      "enum": [
        "Available",
        "Occupied",
        "Maintenance"
      ],
      "default": "Available"
    },
    "address": {
      "type": "text"
    },
    "chargerType": {
      "type": "enumeration",
      "enum": [
        "AC",
        "DC"
      ]
    },
    "connectorTypes": {
      "type": "json"
    },
    "pricePerKwh": {
      "type": "decimal"
    }
  }
}
