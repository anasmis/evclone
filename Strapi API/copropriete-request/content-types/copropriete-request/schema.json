{
  "kind": "collectionType",
  "collectionName": "copropriete_requests",
  "info": {
    "singularName": "copropriete-request",
    "pluralName": "copropriete-requests",
    "displayName": "Copropriété Requests",
    "description": "Demandes pour solutions de recharge en copropriété"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true,
      "maxLength": 20
    },
    "propertyType": {
      "type": "enumeration",
      "enum": [
        "Copropriété résidentielle",
        "Résidence fermée",
        "Immeuble de bureaux",
        "Centre commercial",
        "Autre"
      ],
      "required": true
    },
    "buildingSize": {
      "type": "enumeration",
      "enum": [
        "Moins de vingt logements",
        "Vingt à cinquante logements",
        "Cinquante à cent logements",
        "Plus de cent logements"
      ],
      "required": true
    },
    "parkingSpaces": {
      "type": "enumeration",
      "enum": [
        "Moins de dix places",
        "Dix à trente places",
        "Trente à cinquante places",
        "Plus de cinquante places"
      ],
      "required": true
    },
    "desiredStations": {
      "type": "enumeration",
      "enum": [
        "Une à cinq bornes",
        "Cinq à dix bornes",
        "Dix à vingt bornes",
        "Plus de vingt bornes",
        "Je ne sais pas"
      ],
      "required": true
    },
    "timeline": {
      "type": "enumeration",
      "enum": [
        "Immédiatement",
        "Dans trois mois",
        "Dans six mois",
        "Plus tard"
      ],
      "required": true
    },
    "budget": {
      "type": "enumeration",
      "enum": [
        "Moins de cent mille DH",
        "Cent mille à trois cent mille DH",
        "Trois cent mille à cinq cent mille DH",
        "Plus de cinq cent mille DH",
        "Non défini"
      ]
    },
    "hasElectricalUpgrade": {
      "type": "boolean",
      "default": false
    },
    "message": {
      "type": "text"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "nouveau",
        "contacté",
        "étude_en_cours",
        "devis_envoyé",
        "client_potentiel",
        "fermé"
      ],
      "default": "nouveau"
    },
    "source": {
      "type": "string",
      "default": "EvCopropriete Page"
    },
    "notes": {
      "type": "text"
    },
    "assignedTo": {
      "type": "string"
    }
  }
}
