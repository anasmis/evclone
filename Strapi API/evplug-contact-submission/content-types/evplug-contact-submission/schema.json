{
  "kind": "collectionType",
  "collectionName": "evplug_contact_submissions",
  "info": {
    "singularName": "evplug-contact-submission",
    "pluralName": "evplug-contact-submissions",
    "displayName": "EVPlug Contact Submission"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 150
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string",
      "maxLength": 30
    },
    "topic": {
      "type": "enumeration",
      "enum": [
        "installation-domicile",
        "installation-entreprise",
        "support",
        "autre"
      ],
      "default": "autre"
    },
    "subject": {
      "type": "string",
      "maxLength": 200
    },
    "message": {
      "type": "text"
    },
    "submitted_at": {
      "type": "datetime"
    },
    "pageUrl": {
      "type": "string",
      "maxLength": 500
    },
    "orderType": {
      "type": "enumeration",
      "enum": [
        "contact",
        "order",
        "support"
      ],
      "default": "contact"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "nouveau",
        "lu",
        "repondu",
        "ferme"
      ],
      "default": "nouveau"
    }
  }
}