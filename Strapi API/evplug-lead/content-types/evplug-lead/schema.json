{
  "kind": "collectionType",
  "collectionName": "evplug_leads",
  "info": {
    "singularName": "evplug-lead",
    "pluralName": "evplug-leads",
    "displayName": "EVPlug Lead",
    "description": "Leads soumis depuis le formulaire flottant (FloatingCtaForm) sur les pages solutions, training et home"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 150
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true,
      "maxLength": 30
    },
    "interest": {
      "type": "string",
      "maxLength": 150
    },
    "message": {
      "type": "text"
    },
    "pageUrl": {
      "type": "string",
      "maxLength": 500
    },
    "submittedAt": {
      "type": "datetime"
    },
    "source": {
      "type": "string",
      "default": "FloatingCtaForm",
      "maxLength": 100
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "nouveau",
        "contacte",
        "qualifie",
        "client_potentiel",
        "ferme"
      ],
      "default": "nouveau"
    },
    "notes": {
      "type": "text"
    },
    "assignedTo": {
      "type": "string",
      "maxLength": 150
    }
  }
}
