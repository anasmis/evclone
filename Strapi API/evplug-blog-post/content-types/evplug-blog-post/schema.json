{
  "kind": "collectionType",
  "collectionName": "evplug_blog_posts",
  "info": {
    "singularName": "evplug-blog-post",
    "pluralName": "evplug-blog-posts",
    "displayName": "EVPlug Blog Post"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "content": {
      "type": "richtext"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "image": {
      "type": "string",
      "required": false
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::evplug-author.evplug-author"
    }
  }
}