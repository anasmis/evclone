{
  "kind": "singleType",
  "collectionName": "evone_platform_pages",
  "info": {
    "singularName": "evone-platform-page",
    "pluralName": "evone-platform-pages",
    "displayName": "Evone Platform Page",
    "description": "CMS-managed content for /solutions/evone-management-platform"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "documentTitle": {
      "type": "string",
      "maxLength": 200
    },
    "heroTag": {
      "type": "string",
      "maxLength": 80
    },
    "heroTitle": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "heroSubtitle": {
      "type": "text",
      "maxLength": 500
    },
    "heroCtaLabel": {
      "type": "string",
      "default": "Demander une demo",
      "maxLength": 80
    },
    "heroCtaHref": {
      "type": "string",
      "default": "/contact-us",
      "maxLength": 200
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "featurePills": {
      "type": "component",
      "component": "evone.feature-pill",
      "repeatable": true
    },
    "detailRows": {
      "type": "component",
      "component": "evone.detail-row",
      "repeatable": true
    },
    "midCtaTitle": {
      "type": "string",
      "maxLength": 200
    },
    "midCtaBody": {
      "type": "text",
      "maxLength": 400
    },
    "midCtaLabel": {
      "type": "string",
      "default": "Demander une demo",
      "maxLength": 80
    },
    "midCtaHref": {
      "type": "string",
      "default": "/contact-us",
      "maxLength": 200
    },
    "midCtaDecorImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "midCtaDecorBg": {
      "type": "string",
      "default": "#87b4e1",
      "maxLength": 20
    },
    "operationsRows": {
      "type": "component",
      "component": "evone.detail-row",
      "repeatable": true
    },
    "faqItems": {
      "type": "component",
      "component": "evone.faq-item",
      "repeatable": true
    },
    "ctaInterest": {
      "type": "string",
      "default": "Plateforme Evone",
      "maxLength": 100
    },
    "ctaButtonLabel": {
      "type": "string",
      "default": "Demander une demo",
      "maxLength": 80
    },
    "ctaTitle": {
      "type": "string",
      "default": "Demander une demo Evone",
      "maxLength": 200
    },
    "ctaSubtitle": {
      "type": "text",
      "maxLength": 400
    },
    "ctaAccentColor": {
      "type": "string",
      "default": "#87b4e1",
      "maxLength": 20
    }
  }
}
